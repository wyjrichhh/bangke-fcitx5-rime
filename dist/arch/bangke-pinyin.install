# 装包/升级后的初始化。等价于 deb 的 postinst + 之前那堆 patch 脚本做的事，
# 所以用户只需要 `pacman -U` 一次，不必再手动跑任何脚本。
#
# pacman 的 .INSTALL 由 root 执行；`sudo pacman -U` 会把 SUDO_USER 传下来，
# 据此找到「是谁在装」，好把用户级配置铺到他家目录。

_ldconfig() { ldconfig 2>/dev/null || true; }

# 记下我们动过哪个家目录，卸载时照着回收（与 deb 侧的 /var/lib/bangke-pinyin 同一套约定）。
_BK_STATE=/var/lib/bangke-pinyin
_record() { mkdir -p "$_BK_STATE"; grep -qxF "$2" "$_BK_STATE/$1" 2>/dev/null || echo "$2" >> "$_BK_STATE/$1"; }

# OpenCC：Arch 只有 1.3.x，而 1.3 把带 normalization 的配置编成 PipelineConverter，
# 它的 GetConversionChain() 按设计返回 nullptr，librime 的封装拿到就 ->GetConversions()
# —— 段错误，且不是 C++ 异常、catch(...) 兜不住，表现为「一打字 fcitx5 就崩」。
# 去掉 normalization 就退回普通 Converter。.ocd2 词库跟发行版走（软链过去）。
_seed_opencc() {
  local src=/usr/share/opencc dst=/usr/share/rime-data/opencc
  local fallback=/usr/share/fcitx5-rime/opencc-compat
  [ -d "$src" ] || return 0
  mkdir -p "$dst"
  # 优先按**系统当前**的 opencc 配置现生成，避免发行版升级后配置与词库对不上；
  # 没有 python3 就用随包的兜底副本。
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$src" "$dst" <<'PYEOF' 2>/dev/null || cp -an "$fallback"/. "$dst"/ 2>/dev/null || true
import json, glob, os, sys
src, dst = sys.argv[1], sys.argv[2]
for f in glob.glob(os.path.join(src, "*.json")):
    d = json.load(open(f, encoding="utf-8"))
    d.pop("normalization", None)
    json.dump(d, open(os.path.join(dst, os.path.basename(f)), "w", encoding="utf-8"))
PYEOF
  else
    cp -an "$fallback"/. "$dst"/ 2>/dev/null || true
  fi
  ln -sf "$src"/*.ocd2 "$dst"/ 2>/dev/null || true
  chmod -R a+rX /usr/share/rime-data 2>/dev/null || true
}

_seed_user() {
  local h="$1"
  [ -n "$h" ] && [ -d "$h" ] || return 0
  local seed=/usr/share/fcitx5-rime/seed
  local rime="$h/.local/share/fcitx5/rime"
  mkdir -p "$rime"
  # -n：不能覆盖用户已有的 *.custom.yaml（与 mac/deb 侧的 soft-write 一致）
  cp -an "$seed"/. "$rime"/ 2>/dev/null || true

  # 按键合并出厂配置。
  #
  # 为什么不能整份覆盖：这些 *.custom.yaml 里既有产品管理的键（schema_list、
  # 默认方案），也有用户自己的（设置页把 ai_predict、开关默认值写进同一个文件）。
  # 整份覆盖会把用户改动冲掉；什么都不做又会让出厂配置的更新永远进不来。
  # 所以只动我们拥有、且设置页里没有入口的那部分。
  _merge_factory_config "$h"

  # 顺手把候选面板主题生成出来，用户不必先打开设置程序才有品牌外观。
  # 但 classicui.conf 是 fcitx5 **框架级**的面板配置，对所有输入法生效 —— 用户已经
  # 有配置就绝不覆盖（那等于替别人的输入法改外观）。只在原本没有时给一份品牌默认，
  # 并记下来，卸载时删掉、回到原样。
  if [ -e "$h/.config/fcitx5/conf/classicui.conf" ]; then
    echo "  已有 classicui.conf，跳过主题生成（不覆盖用户面板配置）"
  else
    HOME="$h" fcitx5-rime-config --generate-theme >/dev/null 2>&1 \
      && _record generated-classicui "$h"
  fi

  # 把 rime 注册进输入法组，并**排在第一位**。
  # 不能只追加到末尾：Ctrl+空格 是按组内顺序向后枚举的，末尾等于「按一下切到别的
  # 输入法」。真机（Omarchy 预装了 chewing）上就是这么翻车的。
  _record registered-profile "$h"
  local p="$h/.config/fcitx5/profile"
  mkdir -p "$(dirname "$p")"
  if [ ! -f "$p" ]; then
    printf '[Groups/0]\nName=Default\nDefault Layout=us\nDefaultIM=rime\n\n[Groups/0/Items/0]\nName=rime\nLayout=\n\n[Groups/0/Items/1]\nName=keyboard-us\nLayout=\n\n[GroupOrder]\n0=Default\n' > "$p"
  elif ! grep -q '^Name=rime$' "$p"; then
    # 收集现有输入法（保序去重），rime 打头
    local -a ims=(); local in_items=0 line n skip x
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in
        \[Groups/0/Items/*) in_items=1; continue ;;
        \[*)                in_items=0; continue ;;
      esac
      [ "$in_items" = 1 ] || continue
      case $line in Name=*) ;; *) continue ;; esac
      n=${line#Name=}; skip=0
      for x in ${ims[@]+"${ims[@]}"}; do [ "$x" = "$n" ] && skip=1; done
      [ "$skip" = 1 ] || ims+=("$n")
    done < "$p"
    local -a out=(rime); local has_kb=0
    for n in ${ims[@]+"${ims[@]}"}; do
      [ "$n" = rime ] && continue
      [ "$n" = keyboard-us ] && has_kb=1
      out+=("$n")
    done
    [ "$has_kb" = 1 ] || out+=(keyboard-us)
    { printf '[Groups/0]\nName=Default\nDefault Layout=us\nDefaultIM=rime\n\n'
      local i=0
      for n in "${out[@]}"; do printf '[Groups/0/Items/%s]\nName=%s\nLayout=\n\n' "$i" "$n"; i=$((i+1)); done
      printf '[GroupOrder]\n0=Default\n'; } > "$p.new"
    mv "$p.new" "$p"
  fi

  chown -R "$(stat -c '%U:%G' "$h" 2>/dev/null || echo root)" \
        "$rime" "$h/.config/fcitx5" "$h/.local/share/fcitx5/themes" 2>/dev/null || true
}

# 只把「产品拥有、设置页里没有入口」的键合并进用户已有的 custom 文件，其余原样保留。
#   default.custom.yaml 的 schema_list —— 默认方案
#   <方案>.custom.yaml 的 translator/spelling_hints —— **只在用户没设过时才补**
#     （设置页有「拼写提示」开关，那是用户的，不能每次升级都强行改回去）
_merge_factory_config() {
  local h="$1"
  local rime="$h/.local/share/fcitx5/rime"
  local seed=/usr/share/fcitx5-rime/seed
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$rime" "$seed" <<'PYEOF' 2>/dev/null || true
import os, re, sys
rime, seed = sys.argv[1], sys.argv[2]

def lines(p):
    try:
        return open(p, encoding="utf-8").read().splitlines()
    except Exception:
        return None

# 1) 默认方案：把 seed 的 schema_list 整块搬到用户文件里（这是我们拥有、且设置页无入口的）
dst = os.path.join(rime, "default.custom.yaml")
src = os.path.join(seed, "default.custom.yaml")
d, s = lines(dst), lines(src)
if d is not None and s is not None:
    block = []
    grab = False
    for ln in s:
        if ln.strip().startswith("schema_list:"):
            grab = True
        elif grab and ln.strip() and not ln.startswith("    "):
            break
        if grab:
            block.append(ln)
    if block:
        out, i, replaced = [], 0, False
        while i < len(d):
            if d[i].strip().startswith("schema_list:"):
                out.extend(block); replaced = True
                i += 1
                while i < len(d) and (d[i].startswith("    ") or not d[i].strip()):
                    if not d[i].strip():
                        break
                    i += 1
                continue
            out.append(d[i]); i += 1
        if not replaced:
            for j, ln in enumerate(out):
                if ln.strip() == "patch:":
                    out[j+1:j+1] = block
                    break
        open(dst, "w", encoding="utf-8").write("\n".join(out) + "\n")

# 2) 拼音注释：**只补默认值**。用户文件里已经有这个键就说明他设过，不动。
for name in ("rime_ice.custom.yaml", "luna_pinyin.custom.yaml"):
    p = os.path.join(rime, name)
    ls = lines(p)
    if ls is None:
        continue
    # 已经在迁移过的机器上就完全不动（标记见 _run）
    migrate = os.environ.get("BANGKE_SPELLING_MIGRATED") == "1"
    if any(l.strip().startswith("translator/spelling_hints:") for l in ls) and migrate:
        # 值是我们旧版默认写进去的（1），不是用户按开关改的 —— 一次性纠正为 0。
        # 之后那个键就归用户的「拼写提示」开关管，升级不再碰。
        ls = ["  translator/spelling_hints: 0"
              if l.strip().startswith("translator/spelling_hints:") else l for l in ls]
        open(p, "w", encoding="utf-8").write("\n".join(ls) + "\n")
        continue
    if any(l.strip().startswith("translator/spelling_hints:") for l in ls):
        continue
    for j, ln in enumerate(ls):
        if ln.strip() == "patch:":
            ls[j+1:j+1] = ["  translator/spelling_hints: 0"]
            break
    open(p, "w", encoding="utf-8").write("\n".join(ls) + "\n")
PYEOF
}

# 停/起 fcitx5 用的小工具。
#
# 为什么装包要先停它：**fcitx5 把输入法组放在内存里**，运行时被改动的 profile 会在
# 它退出或配置变更时按内存里的旧内容写回 —— 于是装包时注册进去的 rime 被抹掉，
# 表现就是「装完了却看不到蚌壳拼音」。真机上实测踩过两次（候选面板那条也是同一类）。
_BK_ENV=""
_BK_USER=""

_stop_fcitx5() {
  _BK_ENV=""; _BK_USER=""
  local pid
  pid=$(pgrep -x fcitx5 | head -1)
  [ -n "$pid" ] || return 0
  _BK_USER=$(stat -c '%U' "$pid" 2>/dev/null)
  if [ -r "$pid/environ" ]; then :; fi
  if [ -r "/proc/$pid/environ" ]; then
    local v line
    for v in WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
             XDG_SESSION_TYPE XDG_CURRENT_DESKTOP; do
      line=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -m1 "^$v=")
      [ -n "$line" ] && _BK_ENV="$_BK_ENV $line"
    done
  fi
  pkill -x fcitx5 2>/dev/null || true
  local i
  for i in $(seq 1 10); do pgrep -x fcitx5 >/dev/null || break; sleep 1; done
  pkill -9 -x fcitx5 2>/dev/null || true
}

_start_fcitx5() {
  [ -n "$_BK_USER" ] || return 0
  [ "$_BK_USER" = root ] && return 0
  command -v sudo >/dev/null 2>&1 || return 0
  if [ -n "$_BK_ENV" ]; then
    # shellcheck disable=SC2086
    sudo -u "$_BK_USER" -H env $_BK_ENV fcitx5 -r -d >/dev/null 2>&1 &
  else
    sudo -u "$_BK_USER" -H fcitx5 -r -d >/dev/null 2>&1 &
  fi
}


_run() {
  _ldconfig
  fc-cache -f >/dev/null 2>&1 || true
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
  _seed_opencc
  # 「拼写提示」的一次性迁移：老版本的默认值(=1)不是用户的选择，纠正一次；
  # 之后这个键归用户的开关管，升级不再碰。标记放在 /var/lib 下。
  BANGKE_SPELLING_MIGRATED=0
  [ -f /var/lib/bangke-pinyin/spelling-hints-migrated ] || BANGKE_SPELLING_MIGRATED=1
  export BANGKE_SPELLING_MIGRATED
  mkdir -p /var/lib/bangke-pinyin
  # 写用户配置之前先停 fcitx5，否则它会把内存里的旧输入法组写回来、抹掉我们的注册
  _stop_fcitx5
  _seed_user /etc/skel
  local u="${SUDO_USER:-}"
  if [ -n "$u" ] && [ "$u" != root ]; then
    local uh
    uh="$(getent passwd "$u" | cut -d: -f6)"
    _seed_user "$uh"
  fi
  touch /var/lib/bangke-pinyin/spelling-hints-migrated
  # 让 systemd 用户实例看到新装的 drop-in（托盘图标那条）。
  # 从 root 调用户实例要显式给 XDG_RUNTIME_DIR；拿不到就算了，下次登录自然生效。
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    local rt="/run/user/$(id -u "$SUDO_USER" 2>/dev/null)"
    [ -d "$rt" ] && sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="$rt" \
      systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
  # 用停之前抄下来的会话环境把它拉起来（从 root 里直接起会丢 WAYLAND_DISPLAY）
  _start_fcitx5
  echo "蚌壳拼音：装好了。输入法已重新加载；若看不到「蚌壳拼音」，重新登录一次即可。"
}

post_install() { _run; }
post_upgrade() { _run; }

# 卸载要跟安装对称：安装时替用户写了什么，这里就得撤掉什么。否则会在用户的输入法
# 框架里留下指向已删引擎的死条目、以及我们替他做的框架级改动 —— 等于把人家的输入法
# 框架搞坏。与 deb 侧的 postrm 同一套语义。
_unregister_im() {
  local h="$1" p tmp
  [ -n "$h" ] && [ -d "$h" ] || return 0
  p="$h/.config/fcitx5/profile"
  [ -f "$p" ] || return 0
  tmp="$p.bangke-uninstall"
  # 第一趟：摘掉我们写进去的那段（判据是「节体第一行是 Name=rime」，别人家的不动）。
  awk '
    /^\[Groups\/[0-9]+\/Items\/[0-9]+\]/ {
      hdr = $0; getline nxt
      if (nxt == "Name=rime") { getline; next }
      print hdr; print nxt; next
    }
    { print }
  ' "$p" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  # 第二趟：同组内重新连续编号（留洞会让按组枚举的前端读不动）。
  awk '
    /^\[Groups\/[0-9]+\/Items\/[0-9]+\]$/ {
      split($0, a, /[\/\[\]]+/); g = a[3]
      printf "[Groups/%s/Items/%d]\n", g, idx[g]++
      next
    }
    { print }
  ' "$tmp" > "$tmp.2" 2>/dev/null && mv "$tmp.2" "$p" || { rm -f "$tmp" "$tmp.2"; return 0; }
  rm -f "$tmp"
  sed -i 's/^DefaultIM=rime$/DefaultIM=/' "$p" 2>/dev/null || true
  # profile 整份是我们建的，删干净后只剩空壳 —— 直接删掉，回到「我们没来过」的样子。
  grep -q '^\[Groups/[0-9]*/Items/' "$p" 2>/dev/null || rm -f "$p"
}

post_remove() {
  _stop_fcitx5
  local h
  if [ -f "$_BK_STATE/registered-profile" ]; then
    while IFS= read -r h; do _unregister_im "$h"; done < "$_BK_STATE/registered-profile"
  fi
  if [ -f "$_BK_STATE/generated-classicui" ]; then
    while IFS= read -r h; do
      [ -n "$h" ] && [ -d "$h" ] || continue
      rm -f "$h/.config/fcitx5/conf/classicui.conf"
      rm -rf "$h"/.local/share/fcitx5/themes/bangke* 2>/dev/null || true
    done < "$_BK_STATE/generated-classicui"
  fi
  rm -rf "$_BK_STATE"
  _ldconfig
  _start_fcitx5
}

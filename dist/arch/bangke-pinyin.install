pre_upgrade() {
  if grep -q '^Name=蚌壳拼音$' /usr/share/fcitx5/inputmethod/rime.conf 2>/dev/null; then
    mkdir -p /var/lib/bangke-pinyin
    touch /var/lib/bangke-pinyin/migrate-rime
  fi
}
# User data is checksum-managed by the shared lifecycle helper.
post_install() { bash /usr/lib/bangke-pinyin/package.sh install; }
post_upgrade() { post_install; }
post_remove() { bash /var/lib/bangke-pinyin/lifecycle/package.sh remove; }
